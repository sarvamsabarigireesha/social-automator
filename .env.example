# ---- Server ----
PORT=3000
BASE_URL=http://localhost:3000
# Optional: path to the SQLite file. On Railway/Render, point this at a
# mounted persistent Volume/Disk (e.g. /data/automator.db) so your rules and
# reply history survive redeploys. Leave blank for local dev.
DB_PATH=
# Any random long string, used to secure webhook verification
WEBHOOK_VERIFY_TOKEN=change_this_to_a_random_string

# ---- Meta (Facebook + Instagram) ----
# From https://developers.facebook.com -> My Apps -> Your App -> Settings > Basic
META_APP_ID=
META_APP_SECRET=
# Long-lived Page Access Token (generated after connecting your Page + IG Business account)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ID=

# ---- YouTube (Google Cloud) ----
# From https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
